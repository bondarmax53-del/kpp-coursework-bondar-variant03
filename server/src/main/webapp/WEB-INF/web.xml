<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>ІС технічного обслуговування лабораторного обладнання</display-name>

    <listener>
        <listener-class>ua.nupp.maintenance.AppContextListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>ua.nupp.maintenance.servlet.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/api/health</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EquipmentServlet</servlet-name>
        <servlet-class>ua.nupp.maintenance.servlet.EquipmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EquipmentServlet</servlet-name>
        <url-pattern>/api/equipment/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SpecialistServlet</servlet-name>
        <servlet-class>ua.nupp.maintenance.servlet.SpecialistServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpecialistServlet</servlet-name>
        <url-pattern>/api/specialists/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RequestServlet</servlet-name>
        <servlet-class>ua.nupp.maintenance.servlet.RequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RequestServlet</servlet-name>
        <url-pattern>/api/requests/*</url-pattern>
    </servlet-mapping>
</web-app>
